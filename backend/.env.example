PORT=8080
NODE_ENV=development
CORS_ORIGIN=*

# Optional for future Firebase auth. Leave disabled for the current unauthenticated build.
ENABLE_FIREBASE_AUTH=0
FIREBASE_PROJECT_ID=
# JSON string for a Firebase service account. Leave empty for local unauthenticated development.
FIREBASE_SERVICE_ACCOUNT_JSON=

# MongoDB Atlas. If omitted, the API uses in-memory storage for local development.
MONGO_URI=
MONGO_DB_NAME=wheatee

# Optional adapter. MongoDB is the production database for this build.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Google Cloud services. If omitted, deterministic agronomist fallback responses are used.
VERTEX_PROJECT_ID=
VERTEX_LOCATION=us-central1
GEMINI_MODEL=gemini-3-flash

# Google Cloud Speech-to-Text v2. Defaults to VERTEX_PROJECT_ID when SPEECH_PROJECT_ID is empty.
SPEECH_PROJECT_ID=
SPEECH_LOCATION=global
SPEECH_RECOGNIZER=_
SPEECH_MODEL=chirp_3
SPEECH_LANGUAGE_CODES=ur-PK,en-US

GCS_BUCKET=
