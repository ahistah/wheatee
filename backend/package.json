{
  "name": "wheatee-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.13",
  "scripts": {
    "dev": "bun --watch src/server.ts",
    "start": "bun src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "env -u MONGO_URI -u SUPABASE_URL -u SUPABASE_SERVICE_ROLE_KEY -u FIREBASE_SERVICE_ACCOUNT_JSON -u VERTEX_PROJECT_ID -u GOOGLE_APPLICATION_CREDENTIALS -u GCS_BUCKET -u SPEECH_PROJECT_ID WHEATY_SKIP_DOTENV=1 bun test",
    "seed:knowledge": "bun src/scripts/seedKnowledgeBase.ts",
    "check:deploy": "bash scripts/check-deploy-artifacts.sh",
    "check:health": "bash scripts/check-production-health.sh"
  },
  "dependencies": {
    "@google-cloud/storage": "^7.16.0",
    "@supabase/supabase-js": "^2.107.0",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "firebase-admin": "^13.6.0",
    "google-auth-library": "^9.15.1",
    "mongodb": "^6.20.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/node": "^22.19.1",
    "typescript": "^5.9.3"
  }
}
