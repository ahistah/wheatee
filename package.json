  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "api:dev": "cd backend && bun run dev",
    "api:start": "cd backend && bun run start",
    "api:typecheck": "cd backend && bun run typecheck",
    "api:test": "cd backend && bun run test",
    "api:seed-knowledge": "cd backend && bun run seed:knowledge",
    "api:check-deploy": "cd backend && bun run check:deploy",
    "api:check-health": "cd backend && bun run check:health",
    "check:release": "bash scripts/check-release-config.sh",
    "check:eas-env": "bash scripts/check-eas-production-env.sh",
